# Copy to .env and fill in. .env is gitignored — never commit real credentials.
# Optional on the Pi: sign in from a phone at http://huckdeck.local/ instead.
HUCKLEBERRY_EMAIL=you@example.com
HUCKLEBERRY_PASSWORD=your-password
# IANA timezone name; defaults to America/New_York if unset
HUCKLEBERRY_TZ=America/New_York
